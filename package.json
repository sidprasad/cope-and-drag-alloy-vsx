{
  "name": "cope-and-drag-alloy",
  "displayName": "Cope and Drag for Alloy",
  "description": "Pairs the Alloy Analyzer with the Cope and Drag visualizer in a VS Code webview.",
  "author": "Siddhartha Prasad",
  "publisher": "SiddharthaPrasad",
  "license": "MIT",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "alloy",
    "cope and drag",
    "formal methods"
  ],
  "activationEvents": [
    "onLanguage:alloy"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "alloy",
        "aliases": [
          "Alloy",
          "alloy"
        ],
        "extensions": [
          ".als"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "alloy.openCnd",
        "title": "Open Cope and Drag",
        "category": "Alloy",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "editorLangId == alloy",
          "command": "alloy.openCnd",
          "group": "navigation@0"
        }
      ]
    },
    "configuration": {
      "title": "Alloy + Cope and Drag",
      "properties": {
        "alloy.javaPath": {
          "type": "string",
          "default": "",
          "description": "Path to a Java 17+ executable for the Alloy Analyzer. Leave empty to auto-detect (JAVA_HOME, then an installed JDK 17+, then 'java')."
        },
        "alloy.jarPath": {
          "type": "string",
          "default": "",
          "description": "Path to an Alloy Analyzer jar (Alloy 6+). Leave empty to auto-detect an Alloy install (workspace, Downloads, Desktop, /Applications), then fall back to the bundled jar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "node scripts/bundle-assets.js",
    "package": "vsce package"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.93.0",
    "@types/ws": "^8.5.10",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.3"
  }
}
