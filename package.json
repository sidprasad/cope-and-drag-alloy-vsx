{
  "name": "cope-and-drag-alloy",
  "displayName": "Cope and Drag for Alloy",
  "description": "Pairs the Alloy Analyzer with the Cope and Drag visualizer in a VS Code webview.",
  "author": "Siddhartha Prasad",
  "publisher": "SiddharthaPrasad",
  "license": "MIT",
  "version": "0.1.2",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sidprasad/cope-and-drag-alloy-vsx.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "alloy",
    "cope and drag",
    "formal methods"
  ],
  "activationEvents": [
    "onLanguage:alloy"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "alloy",
        "aliases": [
          "Alloy",
          "alloy"
        ],
        "extensions": [
          ".als"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cnd",
        "aliases": [
          "Cope and Drag spec",
          "cnd"
        ],
        "extensions": [
          ".cnd"
        ],
        "configuration": "./cnd-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "alloy",
        "scopeName": "source.alloy",
        "path": "./syntaxes/alloy.tmLanguage.json"
      },
      {
        "language": "cnd",
        "scopeName": "source.cnd",
        "path": "./syntaxes/cnd.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "alloy.openCnd",
        "title": "Open Cope and Drag",
        "category": "Alloy",
        "icon": "$(graph)"
      },
      {
        "command": "alloy.reloadCnd",
        "title": "Reload Cope and Drag Layout",
        "category": "Alloy",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "editorLangId == alloy",
          "command": "alloy.openCnd",
          "group": "navigation@0"
        }
      ]
    },
    "configuration": {
      "title": "Alloy + Cope and Drag",
      "properties": {
        "alloy.javaPath": {
          "type": "string",
          "default": "",
          "description": "Path to a Java 17+ executable for the Alloy Analyzer. Leave empty to auto-detect (JAVA_HOME, then an installed JDK 17+, then 'java')."
        },
        "alloy.jarPath": {
          "type": "string",
          "default": "",
          "description": "Path to an Alloy Analyzer jar (Alloy 6+). Leave empty to auto-detect an Alloy install (workspace, Downloads, Desktop, /Applications), then offer to download a pinned Alloy release on demand."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle:assets && npm run bundle:js -- --production",
    "compile": "tsc --noEmit -p ./",
    "bundle:assets": "node scripts/bundle-assets.js",
    "bundle:js": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package",
    "tag": "node scripts/tag-release.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "vscode-languageclient": "^9.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.93.0",
    "@types/ws": "^8.5.10",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.3"
  }
}
